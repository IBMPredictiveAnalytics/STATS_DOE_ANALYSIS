<!-- STATS DOE ANALYSIS command syntax -->
<Command xmlns="http://xml.spss.com/spss/extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="extension-1.0.xsd" Name="STATS DOE ANALYSIS" Language="R">
	<Subcommand Name="">
		<Parameter Name="GENERATEDESIGN" ParameterType="Keyword">
			<EnumValue>yes</EnumValue>
			<EnumValue>no</EnumValue>
		</Parameter>
		<Parameter Name="VARNAMES" ParameterType="VariableNameList"/>
		<!-- 3.1.0: factor table of the dialog (one row per new factor) -->
		<Parameter Name="NFACTORS" ParameterType="Integer"/>
		<Parameter Name="FACTORSFROMDATA" ParameterType="Keyword"/>
		<!-- 3.1.0: extreme-vertices mixture designs -->
		<Parameter Name="EVDEGREE" ParameterType="Integer"/>
		<!-- 3.1.0: split-plot designs (hard-to-change factors) -->
		<Parameter Name="HTC" ParameterType="VariableNameList"/>
		<Parameter Name="NAME1" ParameterType="VariableName"/>
		<Parameter Name="LOW1" ParameterType="Number"/>
		<Parameter Name="HIGH1" ParameterType="Number"/>
		<Parameter Name="LEVELS1" ParameterType="Integer"/>
		<Parameter Name="FACTOR1" ParameterType="Keyword"/>
		<Parameter Name="NAME2" ParameterType="VariableName"/>
		<Parameter Name="LOW2" ParameterType="Number"/>
		<Parameter Name="HIGH2" ParameterType="Number"/>
		<Parameter Name="LEVELS2" ParameterType="Integer"/>
		<Parameter Name="FACTOR2" ParameterType="Keyword"/>
		<Parameter Name="NAME3" ParameterType="VariableName"/>
		<Parameter Name="LOW3" ParameterType="Number"/>
		<Parameter Name="HIGH3" ParameterType="Number"/>
		<Parameter Name="LEVELS3" ParameterType="Integer"/>
		<Parameter Name="FACTOR3" ParameterType="Keyword"/>
		<Parameter Name="NAME4" ParameterType="VariableName"/>
		<Parameter Name="LOW4" ParameterType="Number"/>
		<Parameter Name="HIGH4" ParameterType="Number"/>
		<Parameter Name="LEVELS4" ParameterType="Integer"/>
		<Parameter Name="FACTOR4" ParameterType="Keyword"/>
		<Parameter Name="NAME5" ParameterType="VariableName"/>
		<Parameter Name="LOW5" ParameterType="Number"/>
		<Parameter Name="HIGH5" ParameterType="Number"/>
		<Parameter Name="LEVELS5" ParameterType="Integer"/>
		<Parameter Name="FACTOR5" ParameterType="Keyword"/>
		<Parameter Name="NAME6" ParameterType="VariableName"/>
		<Parameter Name="LOW6" ParameterType="Number"/>
		<Parameter Name="HIGH6" ParameterType="Number"/>
		<Parameter Name="LEVELS6" ParameterType="Integer"/>
		<Parameter Name="FACTOR6" ParameterType="Keyword"/>
		<Parameter Name="NAME7" ParameterType="VariableName"/>
		<Parameter Name="LOW7" ParameterType="Number"/>
		<Parameter Name="HIGH7" ParameterType="Number"/>
		<Parameter Name="LEVELS7" ParameterType="Integer"/>
		<Parameter Name="FACTOR7" ParameterType="Keyword"/>
		<Parameter Name="NAME8" ParameterType="VariableName"/>
		<Parameter Name="LOW8" ParameterType="Number"/>
		<Parameter Name="HIGH8" ParameterType="Number"/>
		<Parameter Name="LEVELS8" ParameterType="Integer"/>
		<Parameter Name="FACTOR8" ParameterType="Keyword"/>
		<Parameter Name="NAME9" ParameterType="VariableName"/>
		<Parameter Name="LOW9" ParameterType="Number"/>
		<Parameter Name="HIGH9" ParameterType="Number"/>
		<Parameter Name="LEVELS9" ParameterType="Integer"/>
		<Parameter Name="FACTOR9" ParameterType="Keyword"/>
		<Parameter Name="NAME10" ParameterType="VariableName"/>
		<Parameter Name="LOW10" ParameterType="Number"/>
		<Parameter Name="HIGH10" ParameterType="Number"/>
		<Parameter Name="LEVELS10" ParameterType="Integer"/>
		<Parameter Name="FACTOR10" ParameterType="Keyword"/>
		<Parameter Name="NAME11" ParameterType="VariableName"/>
		<Parameter Name="LOW11" ParameterType="Number"/>
		<Parameter Name="HIGH11" ParameterType="Number"/>
		<Parameter Name="LEVELS11" ParameterType="Integer"/>
		<Parameter Name="FACTOR11" ParameterType="Keyword"/>
		<Parameter Name="NAME12" ParameterType="VariableName"/>
		<Parameter Name="LOW12" ParameterType="Number"/>
		<Parameter Name="HIGH12" ParameterType="Number"/>
		<Parameter Name="LEVELS12" ParameterType="Integer"/>
		<Parameter Name="FACTOR12" ParameterType="Keyword"/>
		<Parameter Name="NAME13" ParameterType="VariableName"/>
		<Parameter Name="LOW13" ParameterType="Number"/>
		<Parameter Name="HIGH13" ParameterType="Number"/>
		<Parameter Name="LEVELS13" ParameterType="Integer"/>
		<Parameter Name="FACTOR13" ParameterType="Keyword"/>
		<Parameter Name="NAME14" ParameterType="VariableName"/>
		<Parameter Name="LOW14" ParameterType="Number"/>
		<Parameter Name="HIGH14" ParameterType="Number"/>
		<Parameter Name="LEVELS14" ParameterType="Integer"/>
		<Parameter Name="FACTOR14" ParameterType="Keyword"/>
		<Parameter Name="NAME15" ParameterType="VariableName"/>
		<Parameter Name="LOW15" ParameterType="Number"/>
		<Parameter Name="HIGH15" ParameterType="Number"/>
		<Parameter Name="LEVELS15" ParameterType="Integer"/>
		<Parameter Name="FACTOR15" ParameterType="Keyword"/>
		<!-- 3.1.0: existing factor columns chosen in the dialog (analysis) -->
		<Parameter Name="FACTORVARS" ParameterType="VariableNameList"/>
		<Parameter Name="FORMULA" ParameterType="QuotedString"/>
		<Parameter Name="FACTORS" ParameterType="KeywordList">
			<EnumValue>yes</EnumValue>
			<EnumValue>no</EnumValue>
		</Parameter>
		<Parameter Name="MIXTURES" ParameterType="KeywordList">
			<EnumValue>yes</EnumValue>
			<EnumValue>no</EnumValue>
		</Parameter>
		<Parameter Name="LOWS" ParameterType="NumberList"/>
		<Parameter Name="HIGHS" ParameterType="NumberList"/>
		<Parameter Name="CENTERS" ParameterType="NumberList"/>
		<Parameter Name="ROUNDTOS" ParameterType="IntegerList"/>
		<Parameter Name="LEVELS" ParameterType="IntegerList"/>
		<Parameter Name="DESIGNTYPE" ParameterType="Keyword">
			<EnumValue>optimal</EnumValue>
			<EnumValue>factorial</EnumValue>
			<EnumValue>plackettburman</EnumValue>
			<EnumValue>rsm</EnumValue>
			<EnumValue>boxbehnken</EnumValue>
			<EnumValue>ccd</EnumValue>
			<EnumValue>taguchi</EnumValue>
			<EnumValue>lhs</EnumValue>
			<EnumValue>dsd</EnumValue>
			<EnumValue>fullfactorial</EnumValue>
			<EnumValue>simplexlattice</EnumValue>
			<EnumValue>simplexcentroid</EnumValue>
			<EnumValue>extremevertices</EnumValue>
		</Parameter>
		<Parameter Name="LATTICEDEGREE" ParameterType="Integer"/>
		<Parameter Name="AUGMENTMIX" ParameterType="Keyword"/>
		<!-- MODEL applies only when DESIGNTYPE=OPTIMAL: it selects the curvature
		     model (LINEAR/QUAD/CUBIC/CUBICS, or a custom FORMULA=) used to build
		     the optimal-design candidate search. For every other DESIGNTYPE
		     (FACTORIAL, PLACKETTBURMAN, RSM, BOXBEHNKEN, CCD, TAGUCHI, LHS, DSD,
		     FULLFACTORIAL), the design generator builds its own intrinsic point
		     structure and MODEL is ignored for generation purposes. -->
		<Parameter Name="MODEL" ParameterType="Keyword"/>
		<Parameter Name="TRIALS" ParameterType="Integer"/>
		<Parameter Name="CONSTANT" ParameterType="Keyword"/>
		<Parameter Name="CONSTRAINTFUNC" ParameterType="InputFile"/>
		<Parameter Name="MIXTURESUM" ParameterType="Number"/>
		<!-- Run-order, blocking and replication options -->
		<Parameter Name="RANDOMIZE" ParameterType="Keyword"/>
		<Parameter Name="BLOCKS" ParameterType="Integer"/>
		<Parameter Name="REPLICATES" ParameterType="Integer"/>
		<!-- NEW: Screening Designs subdialog - center points for 2-level screening designs -->
		<Parameter Name="SCREENINGCENTERPTS" ParameterType="Keyword"/>
		<Parameter Name="SCREENINGCENTERPTSCOUNT" ParameterType="Integer"/>
		<!-- NEW: Sequential DOE - augment an existing factorial design (read from
		     the active dataset) to a Central Composite Design by adding axial
		     (star) points, OFF by default. -->
		<Parameter Name="AUGMENTTOCCD" ParameterType="Keyword"/>
		<Parameter Name="AUGMENTCENTERPTS" ParameterType="Integer"/>
		<Parameter Name="RESPONSEVAR" ParameterType="VariableNameList"/>
		<Parameter Name="ANALYZE" ParameterType="Keyword"/>
		<Parameter Name="CREATEPLOTS" ParameterType="Keyword"/>
		<Parameter Name="OPTIMIZERESPONSE" ParameterType="Keyword"/>
		<Parameter Name="OPTIMIZATIONGOAL" ParameterType="Keyword"/>
		<!-- NEW: Multi-response simultaneous optimization (composite desirability) -->
		<Parameter Name="OPTIMIZATIONGOALS" ParameterType="KeywordList"/>
		<!-- NEW: numeric target value(s) for OPTIMIZATIONGOAL/OPTIMIZATIONGOALS
		     equal to "target"; previously there was no way to specify what
		     "target" should aim for, it silently defaulted to the mean of
		     the observed response. -->
		<Parameter Name="OPTIMIZATIONTARGET" ParameterType="Number"/>
		<Parameter Name="OPTIMIZATIONTARGETS" ParameterType="NumberList"/>
		<!-- NEW: Variable selection — stepwise (AIC) or best subsets -->
		<Parameter Name="VARSELECT" ParameterType="Keyword">
			<EnumValue>yes</EnumValue>
			<EnumValue>no</EnumValue>
		</Parameter>
		<Parameter Name="VARSELMETHOD" ParameterType="Keyword">
			<EnumValue>stepwise</EnumValue>
			<EnumValue>bestsubsets</EnumValue>
		</Parameter>
		<Parameter Name="STEPDIR" ParameterType="Keyword">
			<EnumValue>both</EnumValue>
			<EnumValue>forward</EnumValue>
			<EnumValue>backward</EnumValue>
		</Parameter>
		<!-- Variable selection charts — original visualisations, not derived from any third-party product -->
		<Parameter Name="SELECTIONTRACE" ParameterType="Keyword">
			<EnumValue>yes</EnumValue><EnumValue>no</EnumValue>
		</Parameter>
		<Parameter Name="FITPROFILE" ParameterType="Keyword">
			<EnumValue>yes</EnumValue><EnumValue>no</EnumValue>
		</Parameter>
		<Parameter Name="PARSIMONYPLOT" ParameterType="Keyword">
			<EnumValue>yes</EnumValue><EnumValue>no</EnumValue>
		</Parameter>
		<Parameter Name="FACTORMAP" ParameterType="Keyword">
			<EnumValue>yes</EnumValue><EnumValue>no</EnumValue>
		</Parameter>
	</Subcommand>
	<Subcommand Name="OPTIONS">
		<Parameter Name="CRITERION" ParameterType="Keyword"/>
		<Parameter Name="CENTER" ParameterType="Keyword"/>
		<Parameter Name="DESIGNALG" ParameterType="Keyword"/>
		<Parameter Name="INITIAL" ParameterType="Keyword"/>
		<Parameter Name="REPEATS" ParameterType="Integer"/>
		<Parameter Name="NUMCAND" ParameterType="Integer"/>
	</Subcommand>
	<Subcommand Name="OUTPUT">
		<Parameter Name="CONFOUNDING" ParameterType="Keyword"/>
		<!-- NEW: Additional output options -->
		<Parameter Name="MAINEFFECTS" ParameterType="Keyword"/>
		<Parameter Name="INTERACTIONS" ParameterType="Keyword"/>
		<Parameter Name="CUBEPLOT" ParameterType="Keyword"/>
		<Parameter Name="CONTOURPLOT" ParameterType="Keyword"/>
		<Parameter Name="RESIDUALPLOTS" ParameterType="Keyword"/>
		<Parameter Name="PARETOPLOT" ParameterType="Keyword"/>
		<!-- NEW: Curvature Check Plot - average response at factorial (cube)
		     points vs. center points, visual companion to the curvature term -->
		<Parameter Name="CURVATUREPLOT" ParameterType="Keyword"/>
		<Parameter Name="EXTERNALPLOTS" ParameterType="Keyword"/>
		<!-- NEW: Interactive state-of-the-art HTML report export (additive to static charts) -->
		<Parameter Name="EXPORTHTML" ParameterType="Keyword"/>
		<Parameter Name="HTMLPATH" ParameterType="OutputFile"/>
		<!-- NEW: Output subdialog - additional tables derived from existing results -->
		<Parameter Name="EFFECTSTABLE" ParameterType="Keyword"/>
		<Parameter Name="RESIDUALTESTS" ParameterType="Keyword"/>
		<Parameter Name="VIFTABLE" ParameterType="Keyword"/>
		<Parameter Name="OPTDETAILTABLE" ParameterType="Keyword"/>
		<!-- NEW: Screening Designs subdialog - effect ranking/summary table -->
		<Parameter Name="SCREENINGSUMMARY" ParameterType="Keyword"/>
		<!-- 3.1.0: interactive Model and Optimizer Lab in the HTML report -->
		<Parameter Name="LAB" ParameterType="Keyword"/>
		<!-- 3.1.0: next-experiment advisor -->
		<Parameter Name="ADVISOR" ParameterType="Keyword"/>
		<!-- 3.1.0: uncertainty map -->
		<Parameter Name="UNCERTAINTYMAP" ParameterType="Keyword"/>
		<Parameter Name="UNCERTAINTYLIMIT" ParameterType="Number"/>
	</Subcommand>
	<!-- NEW: Power and Sample Size calculator (plan run counts before generating a design) -->
	<Subcommand Name="POWER" Occurrence="Optional">
		<Parameter Name="POWERTABLE" ParameterType="Keyword"/>
		<Parameter Name="POWEREFFECTSIZES" ParameterType="NumberList"/>
		<Parameter Name="POWERRUNS" ParameterType="IntegerList"/>
		<Parameter Name="POWERALPHA" ParameterType="Number"/>
		<Parameter Name="POWERTARGET" ParameterType="Number"/>
	</Subcommand>
	<!-- Coded-factor model for analysis (two-level factorial, screening and
	     response-surface designs). See the help file for the TERMS syntax. -->
	<Subcommand Name="FITMODEL" Occurrence="Optional">
		<Parameter Name="ANALYSISMODEL" ParameterType="Keyword">
			<EnumValue>coded</EnumValue>
			<EnumValue>legacy</EnumValue>
		</Parameter>
		<Parameter Name="TERMS" ParameterType="QuotedString"/>
		<!-- 3.1.0: standard model shortcut from the Model dialog -->
		<Parameter Name="TERMSET" ParameterType="Keyword"/>
		<!-- 3.1.0: analyze variability -->
		<Parameter Name="VARIABILITY" ParameterType="Keyword"/>
		<Parameter Name="WHOLEPLOT" ParameterType="VariableName"/>
		<Parameter Name="ALPHA" ParameterType="Number"/>
		<Parameter Name="BACKWARD" ParameterType="Keyword"/>
		<Parameter Name="ALPHAREMOVE" ParameterType="Number"/>
		<Parameter Name="CENTERTERM" ParameterType="Keyword"/>
		<Parameter Name="CONFLEVEL" ParameterType="Number"/>
		<Parameter Name="LOWLEVELS" ParameterType="QuotedString"/>
		<Parameter Name="EQUATION" ParameterType="Keyword"/>
		<Parameter Name="INTERPRET" ParameterType="Keyword"/>
		<Parameter Name="PREDICT" ParameterType="QuotedString"/>
		<Parameter Name="ALIASTABLE" ParameterType="Keyword"/>
		<Parameter Name="DIAGTABLE" ParameterType="Keyword"/>
		<Parameter Name="FACTORINFO" ParameterType="Keyword"/>
		<Parameter Name="EFFECTSPLOT" ParameterType="Keyword"/>
		<Parameter Name="SELECTION" ParameterType="Keyword"/>
		<Parameter Name="ALPHAENTER" ParameterType="Number"/>
		<Parameter Name="BOXCOX" ParameterType="Keyword"/>
		<Parameter Name="LAMBDA" ParameterType="Number"/>
		<Parameter Name="CATEGORICAL" ParameterType="VariableNameList"/>
		<Parameter Name="GROUPING" ParameterType="Keyword"/>
		<Parameter Name="CANONICAL" ParameterType="Keyword"/>
		<Parameter Name="SURFACEPLOT" ParameterType="Keyword"/>
		<Parameter Name="MIXMODEL" ParameterType="Keyword"/>
		<Parameter Name="MIXCOMPS" ParameterType="Keyword"/>
		<Parameter Name="TRACEPLOT" ParameterType="Keyword"/>
		<Parameter Name="SNTYPE" ParameterType="Keyword"/>
	</Subcommand>
	<!-- Response optimization settings (one value per RESPONSEVAR, in order) -->
	<Subcommand Name="OPTIMIZE" Occurrence="Optional">
		<Parameter Name="LOWERS" ParameterType="NumberList"/>
		<Parameter Name="UPPERS" ParameterType="NumberList"/>
		<Parameter Name="WEIGHTS" ParameterType="NumberList"/>
		<Parameter Name="IMPORTANCE" ParameterType="NumberList"/>
		<Parameter Name="HOLD" ParameterType="QuotedString"/>
		<!-- 3.1.0: profit / cost goal -->
		<Parameter Name="PROFIT" ParameterType="QuotedString"/>
		<Parameter Name="PROFITGOAL" ParameterType="Keyword"/>
		<Parameter Name="PROFITLIMITS" ParameterType="QuotedString"/>
		<Parameter Name="SOLUTIONS" ParameterType="Integer"/>
		<Parameter Name="OVERLAY" ParameterType="Keyword"/>
		<Parameter Name="ROBUST" ParameterType="Keyword"/>
		<Parameter Name="ROBUSTSD" ParameterType="Number"/>
		<Parameter Name="CONFIRMRUNS" ParameterType="Integer"/>
	</Subcommand>
	<Subcommand Name="SAVE" Occurrence="Optional">
		<Parameter Name="DATASET" ParameterType="DatasetName"/>
	</Subcommand>
	<Subcommand Name="HELP" Occurrence="Optional"/>
</Command>

